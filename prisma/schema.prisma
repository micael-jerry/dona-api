// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum Language {
  FR
  EN
  ES
}

enum EventStatus {
  ACTIVE
  RESOLVING
  EXPIRED
}

enum EventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                    String             @id @default(cuid(2))
  email                 String             @unique
  pseudo                String             @unique @db.VarChar(25)
  name                  String             @db.VarChar(100)
  password              String?            @db.VarChar(100)
  role                  UserRole           @default(USER)
  avatar                String?            @default("https://api.dicebear.com/10.x/avataaars-neutral/png?seed=Felix")
  isEmailVerified       Boolean            @default(false)
  isOAuthGoogleProvider Boolean            @default(false)
  settings              UserSettings?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  events                Event[]
  userConfirmEvents     UserConfirmEvent[]
  userResolveEvents     UserResolveEvent[]
}

model UserSettings {
  id        String   @id @default(cuid(2))
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme     Theme    @default(SYSTEM)
  language  Language @default(FR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Tracks consumed single-use JWT IDs (JTI) to prevent token reuse.
/// A token whose JTI is present in this table has already been used and must be rejected.
model UsedToken {
  jti       String   @id // UUID v4 — unique JWT identifier
  expiresAt DateTime // mirrors token expiry — allows future cleanup jobs
  usedAt    DateTime @default(now()) // audit: when the token was consumed
}

model EventCategory {
  id        String   @id @default(cuid(2))
  value     String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  events Event[]

  @@map("event_categories")
}

model Event {
  id              String        @id @default(cuid(2))
  userId          String
  eventCategoryId String
  severity        EventSeverity @default(LOW)
  status          EventStatus   @default(ACTIVE)

  latitude  Float
  longitude Float

  title       String   @db.VarChar(150)
  description String   @db.Text
  address     String   @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventCategory EventCategory      @relation(fields: [eventCategoryId], references: [id], onDelete: Restrict)
  confirmations UserConfirmEvent[]
  resolutions   UserResolveEvent[]

  @@map("events")
}

model UserConfirmEvent {
  id        String   @id @default(cuid(2))
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("user_confirm_events")
}

model UserResolveEvent {
  id        String   @id @default(cuid(2))
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("user_resolve_events")
}
