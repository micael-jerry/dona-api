// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum Language {
  FR
  EN
  ES
}

model User {
  id                    String        @id @default(cuid(2))
  email                 String        @unique
  pseudo                String        @unique @db.VarChar(25)
  name                  String        @db.VarChar(100)
  password              String?       @db.VarChar(100)
  role                  UserRole      @default(USER)
  avatar                String?       @default("https://api.dicebear.com/10.x/avataaars-neutral/png?seed=Felix")
  isEmailVerified       Boolean       @default(false)
  isOAuthGoogleProvider Boolean       @default(false)
  settings              UserSettings?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model UserSettings {
  id        String   @id @default(cuid(2))
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme     Theme    @default(SYSTEM)
  language  Language @default(FR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Tracks consumed single-use JWT IDs (JTI) to prevent token reuse.
/// A token whose JTI is present in this table has already been used and must be rejected.
model UsedToken {
  jti       String   @id // UUID v4 — unique JWT identifier
  expiresAt DateTime // mirrors token expiry — allows future cleanup jobs
  usedAt    DateTime @default(now()) // audit: when the token was consumed
}
